{
  "extends": "./tsconfig.json",
  "include": ["src", "test"],
  "compilerOptions": {
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@domain/*": ["src/domain/*"],
      "@implementation/*": ["src/implementation/*"],
      "@pages/*": ["src/pages/*"],
      "@presentation-app/*": ["src/presentation/app/*"],
      "@presentation-core/*": ["src/presentation/core/*"],
      "@presentation-theming": ["src/presentation/theming"],
      "@utils/*": ["src/utils/*"]
    }
  }
}

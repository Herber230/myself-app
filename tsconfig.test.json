{
  "extends": "./tsconfig.json",
  "include": ["src", "test"],
  "compilerOptions": {
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@domain-app/*": ["src/domain/app/*"],
      "@domain-generic/*": ["src/domain/generic/*"],
      "@implementation/*": ["src/implementation/*"],
      "@pages/*": ["src/pages/*"],
      "@presentation-app/*": ["src/presentation/app/*"],
      "@presentation-core/*": ["src/presentation/core/*"],
      "@presentation-theming/*": ["src/presentation/theming/*"],
      "@use-cases-app/*": ["src/use-cases/app/*"],
      "@use-cases-generic/*": ["src/use-cases/generic/*"],
      "@utils/*": ["src/utils/*"]
    }
  }
}

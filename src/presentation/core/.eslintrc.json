{
  "extends": ["../../../.eslintrc.json"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@config/*",
              "@domain-app/*",
              "@domain-generic/*",
              "@implementation/*",
              "@pages/*",
              "@presentation-app/*",
              "@use-cases-app/*",
              "@use-cases-generic/*"
            ]
          }
        ]
      }
    }
  ]
}

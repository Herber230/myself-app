{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext", "decorators", "esnext.decorators"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "out",
    "node_modules",
    ".next/dev",
    "eslint.config.mjs",
    "vitest.config.mts"
  ],
  "references": [
    {
      "path": "../../packages/static-adapter"
    },
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/content"
    }
  ]
}

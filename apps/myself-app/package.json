{
  "name": "myself-app",
  "version": "0.0.0",
  "private": true,
  "description": "The site: a Next app exported as static files.",
  "dependencies": {
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/i18n": "catalog:",
    "@entifix/react-controls": "catalog:",
    "@entifix/style": "catalog:",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@myself-app/content": "workspace:*",
    "@myself-app/domain": "workspace:*",
    "@myself-app/static-adapter": "workspace:*",
    "effect": "catalog:",
    "i18next": "26.4.2",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "17.0.15"
  },
  "nx": {
    "tags": [
      "layer:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "^typecheck"
        ],
        "outputs": [
          "{projectRoot}/.next",
          "{projectRoot}/out"
        ],
        "options": {
          "forwardAllArgs": false
        }
      },
      "pdf": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node tools/render-pdfs.mjs apps/myself-app/out"
        }
      },
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "next dev -p 3000",
          "cwd": "apps/myself-app"
        }
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "typegen": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/app/**/*",
          "{projectRoot}/next.config.js"
        ],
        "outputs": [
          "{projectRoot}/next-env.d.ts",
          "{projectRoot}/.next/types"
        ],
        "options": {
          "command": "next typegen",
          "cwd": "apps/myself-app"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "typegen",
          "^build",
          "^typecheck"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "options": {
          "command": "tsc -p tsconfig.json --noEmit",
          "cwd": "apps/myself-app"
        }
      },
      "serve-out": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node tools/serve-static.mjs apps/myself-app/out 3100"
        }
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}

{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "dom.iterable", "esnext", "decorators", "esnext.decorators"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.fixture.ts",
    "dist",
    "out-tsc",
    "test-output"
  ],
  "references": [
    {
      "path": "../../domain/tsconfig.lib.json"
    },
    {
      "path": "../../content/tsconfig.lib.json"
    },
    {
      "path": "../../entifix-incubator/static-adapter/tsconfig.lib.json"
    },
    {
      "path": "../../entifix-incubator/browser/tsconfig.lib.json"
    }
  ]
}

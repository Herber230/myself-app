    "outDir": "out-tsc/ui",
    "tsBuildInfoFile": "out-tsc/ui/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext", "decorators", "esnext.decorators"],
    "types": ["node"]

{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext", "decorators", "esnext.decorators"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test",
    "dist",
    "out-tsc",
    "test-output"
  ],
  "references": [
    {
      "path": "../../entifix-incubator/static-adapter/tsconfig.lib.json"
    },
    {
      "path": "../../entifix-incubator/react-controls/tsconfig.lib.json"
    },
    {
      "path": "../../entifix-incubator/browser/tsconfig.lib.json"
    },
    {
      "path": "../../domain/tsconfig.lib.json"
    },
    {
      "path": "../adapters/tsconfig.lib.json"
    }
  ]
}

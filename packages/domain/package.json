{
  "name": "@myself-app/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The site's business: its entities, the use cases that read them and the rules content must keep, compiled by SWC with 2022-03 decorators — which Next's own compiler cannot do.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@myself-app/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./entities/*": {
      "@myself-app/source": "./src/entities/*.entity.ts",
      "types": "./dist/entities/*.entity.d.ts",
      "import": "./dist/entities/*.entity.js",
      "default": "./dist/entities/*.entity.js"
    },
    "./locales": {
      "@myself-app/source": "./src/locales.ts",
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js",
      "default": "./dist/locales.js"
    },
    "./use-cases": {
      "@myself-app/source": "./src/use-cases/index.ts",
      "types": "./dist/use-cases/index.d.ts",
      "import": "./dist/use-cases/index.js",
      "default": "./dist/use-cases/index.js"
    }
  },
  "sideEffects": true,
  "nx": {
    "tags": [
      "layer:domain"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/domain/dist",
          "main": "packages/domain/src/index.ts",
          "tsConfig": "packages/domain/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@entifix/core": "catalog:",
    "@myself-app/entifix-incubator-static-adapter": "workspace:*",
    "@swc/helpers": "0.5.23",
    "effect": "catalog:"
  }
}

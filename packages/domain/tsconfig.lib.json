{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.fixture.ts",
    "dist",
    "out-tsc",
    "test-output"
  ],
  "references": [
    {
      "path": "../entifix-incubator/static-adapter/tsconfig.lib.json"
    }
  ]
}

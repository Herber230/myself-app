{
  "name": "@myself-app/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What is true about me, as JSON. Imports nothing, and is validated by the adapter that reads it.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@myself-app/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "layer:content"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/content/dist",
          "main": "packages/content/src/index.ts",
          "tsConfig": "packages/content/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true,
          "assets": [
            {
              "input": "packages/content/src",
              "glob": "*.json",
              "output": "."
            }
          ]
        }
      }
    }
  }
}

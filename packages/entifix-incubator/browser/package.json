{
  "name": "@myself-app/entifix-incubator-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The browser's side of a static site's content: a repository read from a static JSON file the build wrote. Knows no entity of this site.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@myself-app/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "layer:incubator"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/entifix-incubator/browser/dist",
          "main": "packages/entifix-incubator/browser/src/index.ts",
          "tsConfig": "packages/entifix-incubator/browser/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@entifix/business": "catalog:",
    "@entifix/core": "catalog:",
    "@entifix/react-integration": "catalog:",
    "@myself-app/entifix-incubator-static-adapter": "workspace:*",
    "@swc/helpers": "0.5.23",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
